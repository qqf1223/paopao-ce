# syntax=docker/dockerfile:1

# 构建阶段
FROM --platform=$BUILDPLATFORM golang:1.24 AS builder

# 设置工作目录
WORKDIR /build

# 首先复制 go.mod 和 go.sum 以利用缓存
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY . .

# 构建应用
ARG TARGETOS TARGETARCH
RUN CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o paopao-ce

# 运行阶段
FROM debian:bookworm-slim

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# 创建应用目录
WORKDIR /app/paopao-ce

# 从构建阶段复制二进制文件
COPY --from=builder /build/paopao-ce .

# 设置时区
ENV TZ=Asia/Shanghai

# 暴露端口
EXPOSE 8008

# 启动应用
CMD ["./paopao-ce", "serve"] 